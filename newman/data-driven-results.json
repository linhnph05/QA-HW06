                "  const body = pm.response.json();",
                "  const keys = Object.keys(body).sort();",
                "  if (schemaKind === \"success\") {",
                "    pm.expect(keys).to.eql([\"message\", \"resetToken\"]);",
                "    pm.expect(body.message).to.be.a(\"string\");",
                "    pm.expect(body.resetToken).to.be.a(\"string\");",
                "  } else {",
                "    pm.expect(keys).to.eql([\"error\"]);",
                "    pm.expect(body.error).to.be.a(\"string\");",
                "  }",
                "});"
